# ── Chapter-1 ERP API ──
CHP1_API_BASE_URL=https://dev.chapter1.finance/aiAnalytics/
CHP1_API_TOKEN=your_api_token_here
COMPANY_ID=355
CHP1_API_TIMEOUT=10

# ── Embedding Model (bge-m3 via Ollama) ──
EMB_MODEL=bge-m3:latest
EMB_BASE_URL=http://localhost:11434/v1
EMB_MODEL_API_KEY=ollama

# ── Translator / Normalizer LLM (lightweight model) ──
TRANS_LLM_MODEL=qwen3:latest
TRANS_BASE_URL=http://localhost:11434/v1
TRANS_MODEL_API_KEY=ollama

# ── Worker LLM (tool calling) ──
LLM_MODEL=qwen3:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_API_KEY=ollama
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Summary / Response LLM (can be same as worker) ──
SUMMARY_LLM_MODEL=qwen3:latest
SUMMARY_BASE_URL=http://localhost:11434/v1
SUMMARY_MODEL_API_KEY=ollama

# ── Output format (text or json) ──
OUTPUT_FORMAT=text

# ── Streamlit UI backend URL ──
BACKEND_URL=http://127.0.0.1:8000

# ── LangSmith tracing (optional, leave blank to disable) ──
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
